# Copy to .env. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
GEMINI_TIMEOUT_SECONDS=30

# Must stay outside MEDIA/STATIC. Blank means <project>/private_storage.
PRIVATE_STORAGE_DIR=
RETRIEVAL_MIN_SIMILARITY=0.55
ASK_RATE_LIMIT_PER_MINUTE=20

# Local mongod or an Atlas URI.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=knowledge_assistant
# Only numpy is implemented (optional Atlas $vectorSearch backend skipped).
VECTOR_BACKEND=numpy
