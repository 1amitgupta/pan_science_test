# Copy to .env. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
GEMINI_TIMEOUT_SECONDS=15
GEMINI_THINKING_LEVEL=low

# Must stay outside MEDIA/STATIC. Blank means <project>/private_storage.
PRIVATE_STORAGE_DIR=
RETRIEVAL_MIN_SIMILARITY=0.55
ASK_RATE_LIMIT_PER_MINUTE=20

# Local mongod or an Atlas URI.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=knowledge_assistant
# numpy (default, any MongoDB) or mongo (Atlas $vectorSearch).
VECTOR_BACKEND=numpy
# VECTOR_BACKEND=mongo needs Atlas (or mongot) + `python manage.py create_vector_index`
MONGO_VECTOR_INDEX=chunk_embedding_index
VECTOR_SEARCH_LIMIT=200
